# Copy to .env before running `docker compose up` if you want to override anything.
# PLACEHOLDERS ONLY — never commit real credentials to this file.

# ---- published ports ---------------------------------------------------------------------------
WEB_PORT=5173
API_PORT=4000

# ---- MongoDB -----------------------------------------------------------------------------------
# Inside compose the API reaches Mongo by service name; use 127.0.0.1 only for non-Docker runs.
MONGO_URL=mongodb://mongo:27017
MONGO_DB_NAME=live_node_graph
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_RETRIES=10

# ---- API ---------------------------------------------------------------------------------------
# Comma separated list, or * to allow any origin.
CORS_ORIGINS=*
DEFAULT_GRAPH_ID=default
SIMULATION_TIMEOUT_MS=15000
LOG_LEVEL=info

# ---- Simulation service (the only service that runs ngspice) -----------------------------------
SIMULATION_SERVICE_URL=http://simulation:8000
SIM_PORT=8000
NGSPICE_BIN=ngspice
SIM_TIMEOUT_S=5
SIM_MAX_OUTPUT_BYTES=262144
# Set to true to keep generated decks in the container for debugging.
SIM_KEEP_DECKS=false
SIM_LOG_NETLISTS=true

# ---- Frontend (dev server only; the Docker image uses nginx instead) ---------------------------
# Where `vite dev` proxies /api and /health.
VITE_API_PROXY_TARGET=http://localhost:4000
VITE_PORT=5173
VITE_PREVIEW_PORT=5174

# ---- Non-Docker local development ------------------------------------------------------------
# MONGO_URL=mongodb://127.0.0.1:27017
# SIMULATION_SERVICE_URL=http://127.0.0.1:8000
